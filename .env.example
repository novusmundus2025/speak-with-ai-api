PORT=8787
HOST=127.0.0.1
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Keep this enabled for local UI development without consuming AI credits.
USE_MOCK_MUNDUSX=true

# MundusX OpenAI-compatible API settings. Both API key and model are optional.
# Keep the key server-only if authentication is enabled later.
MUNDUSX_BASE_URL=https://mundusx.ai
MUNDUSX_API_MODE=speakai
MUNDUSX_API_KEY=
MUNDUSX_MODEL=
MUNDUSX_TIMEOUT_MS=120000
MUNDUSX_POLL_INTERVAL_MS=1000
